# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Streamlit Frontend Configuration
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8501

# Endpoint Agent Configuration
BACKEND_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=30

# Application Environment
ENVIRONMENT=development

# Search Provider Configuration (Step 3) - SearXNG Open Source
SEARCH_PROVIDER=SearXNG
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_ENGINES=google,bing,duckduckgo
SEARXNG_CATEGORIES=general,it
ENABLE_DEV_SEARCH_FALLBACK=true

# Web Collector Configuration (Step 4)
WEB_COLLECTOR_TIMEOUT_SECONDS=20
WEB_COLLECTOR_MAX_SIZE_BYTES=10485760
WEB_COLLECTOR_MAX_RETRIES=2

# PDF / Document Collector Configuration (Step 5)
MAX_DOCUMENT_BYTES=26214400
DOCUMENT_DOWNLOAD_TIMEOUT_SECONDS=30

# Optional Vendor API Collector Configuration (Step 6)
API_REQUEST_DELAY_SECONDS=0.5
MAX_API_RESPONSE_BYTES=10485760
MAX_API_REQUESTS_PER_RUN=10
API_COLLECTOR_TIMEOUT_SECONDS=20
API_COLLECTOR_MAX_RETRIES=2

# Batch Research & Monitoring Configuration (Steps 11-12)
MAX_CONCURRENT_RESEARCH=3
MONITORING_ENABLED=true
DEFAULT_MONITOR_FREQUENCY=WEEKLY

# Research Prioritization Policy (Step 17)
POLICY_MIN_PROFILE_QUALITY=75
POLICY_PROFILE_FRESHNESS_DAYS=90
POLICY_MAX_DAILY_RESEARCH=50
POLICY_MAX_BATCH_RESEARCH=20
